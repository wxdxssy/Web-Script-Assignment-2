<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!--Display title from express router-->
  <title>
    <%= title %>
  </title>

  <!-- Link Bootstrap, Font Awesome, and stylesheet -->
  <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/@fortawesome/fontawesome-free/css/all.min.css">
  <link rel="stylesheet" href="/content/app.css">
</head>

<body>
  <!-- Use Bootstrap navbar with a drawer on smaller screens. -->
  <nav class="navbar md:navbar-expand bg-1">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Waseed's Portfolio</a>

      <!-- Open the navigation drawer on smaller screens. -->
      <button class="btn-icon navbar-toggler" type="button" data-bs-toggle="drawer" data-bs-target="#navbarDrawer"
        aria-controls="navbarDrawer" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon" aria-hidden="true"></span>
      </button>

      <dialog class="drawer drawer-end" tabindex="-1" id="navbarDrawer" aria-labelledby="navbarDrawerLabel">

        <div class="drawer-header">
          <h5 class="drawer-title" id="navbarDrawerLabel">Menu</h5>
          <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close"></button>
        </div>

        <div class="drawer-body mb-2 md:mb-0">
          <ul class="nav navbar-nav me-auto">

            <!-- Highlight Home only when on the Home. -->
            <li class="nav-item">
              <% if (title=='Home' ) { %>
                <a class="nav-link active" aria-current="page" href="/">Home</a>
                <% } else { %>
                  <a class="nav-link" href="/">Home</a>
                  <% } %>
            </li>

            <!-- Highlight About Me only when on About Me-->
            <li class="nav-item">
              <% if (title=='About Me' ) { %>
                <a class="nav-link active" aria-current="page" href="/aboutme">About Me</a>
                <% } else { %>
                  <a class="nav-link" href="/aboutme">About Me</a>
                  <% } %>
            </li>

            <!-- Highlight Projects only when on Projects-->
            <li class="nav-item">
              <% if (title=='Projects' ) { %>
                <a class="nav-link active" aria-current="page" href="/projects">Projects</a>
                <% } else { %>
                  <a class="nav-link" href="/projects">Projects</a>
                  <% } %>
            </li>

            <!-- Highlight Contact Me only when on Contact Me -->
            <li class="nav-item">
              <% if (title=='Contact Me' ) { %>
                <a class="nav-link active" aria-current="page" href="/contactme">Contact Me</a>
                <% } else { %>
                  <a class="nav-link" href="/contactme">Contact Me</a>
                  <% } %>
            </li>

          </ul>
        </div>
      </dialog>
    </div>
  </nav>

  <!-- Show page and content. -->
  <main class="container">
    <h1>
      <%= title %>
    </h1>
    <p>Welcome to <%= title %>
    </p>
  </main>

  <!-- Load Bootstrap js for the nav drawer. -->
<script type="module" src="/bootstrap/js/dist/drawer.js"></script>
</body>

</html>